# Plana environment

# FastAPI agent server. `pnpm dev` starts it on port 8123.
AGENT_URL=http://localhost:8123
FIXED_AGENT_URL=http://localhost:8123/fixed
DYNAMIC_AGENT_URL=http://localhost:8123/dynamic

# Gemini is required for live Plana generations.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional Gemini model override.
# MODEL=gemini-3.5-flash

# Set to 1 to make the fixed designer return a built-in Plana sample layout
# without calling Gemini. The dynamic agent still requires GEMINI_API_KEY.
# OFFLINE=1

# Optional furniture-shopping search.
# Get a key at https://linkup.so
LINKUP_API_KEY=

# Archived/example surfaces only. Leave unset for the Plana app.
# LEGAL_AGENT_URL=http://localhost:8123/legal
# A2A_AGENT_URL=
# A2A_INSTRUCTIONS=
# MCP_SERVER_URL=https://mcp.excalidraw.com
